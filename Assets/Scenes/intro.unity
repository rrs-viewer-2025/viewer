  - "\u5BB6\u304C\u305F\u304A\u308C\u305F\u308A\u3001\n\u9053\u8DEF\u304C\u3053\u308F\u308C\u305F\u308A\u3057\u305F\u3088\u3002"
  - "\u3058\u3057\u3093\u304B\u3089\u8EAB\u3092\u5B88\u308B\u305F\u3081\u306B\u306F\u3001\n\u3075\u3060\u3093\u304B\u3089\u3058\u3085\u3093\u3073\u3059\u308B\u3053\u3068\u304C\n\u5927\u5207\u306A\u3093\u3060\u3002"
  - <q>1
  - "\u305D\u3057\u3066\u3001\n\u3082\u3046\u3072\u3068\u3064\u5927\u5207\u306A\u3053\u3068\u304C\u3042\u308B\u3088\u3002\n"
  - "\u3058\u3057\u3093\u304C\u304A\u304D\u305F\u3068\u304D\u306B\u3001\n\u3069\u3053\u3078\u884C\u3051\u3070\u5B89\u5168\u306A\u306E\u304B\n\u77E5\u3063\u3066\u304A\u304F\u3053\u3068\u304C\u5927\u5207\u306A\u3093\u3060\u3002"
  - <q>2
  - "\u3053\u308C\u304B\u3089\u3053\u306E\u30B7\u30DF\u30E5\u30EC\u30FC\u30B7\u30E7\u30F3\u3067\u3001\n\u3072\u306A\u3093\u4F53\u9A13\u3092\u3057\u3066\u307F\u3088\u3046\uFF01"
  _questions:
  - "\u30C6\u30EC\u30D3\u3084\u30CB\u30E5\u30FC\u30B9\u3067\u3001\n\u5927\u304D\u306A\u3058\u3057\u3093\u304C\u3042\u3063\u305F\u306E\u3092\n\u898B\u305F\u3053\u3068\u304C\u3042\u308B\u304B\u306A\uFF1F"
  - "\u304D\u307F\u306E\u5BB6\u3067\u306F\u3001\n\u3069\u3093\u306A\u3058\u3057\u3093\u306E\u305F\u3044\u3055\u304F\u3092\n\u3057\u3066\u3044\u308B\u306E\u304B\u306A\uFF1F"
  - "\u3058\u3057\u3093\u304C\u304A\u304D\u305F\u3068\u304D\u3001\n\u3069\u3053\u3078\u3072\u306A\u3093\u3059\u308C\u3070\u3044\u3044\u304B\n\u308F\u304B\u308B\u304B\u306A\uFF1F"
  _choices:
  - "\u306F\u3044\n\u3044\u3044\u3048"
  - "\u6C34\u3084\u98DF\u3079\u7269\u3092\u7528\u610F\u3057\u3066\u3044\u308B\n\u5BB6\u5177\u304C\u305F\u304A\u308C\u306A\u3044\u3088\u3046\u306B\u3057\u3066\u3044\u308B\n\u308C\u3093\u3089\u304F\u306E\u53D6\u308A\u65B9\u3092\u6C7A\u3081\u3066\u3044\u308B\n\u306A\u306B\u3082\u3057\u3066\u3044\u306A\u3044"
  - "\u5B66\u6821\n\u516C\u5712\n\u516C\u6C11\u9928\n\u308F\u304B\u3089\u306A\u3044"
  _feedback:
  - "\u3088\u304F\u77E5\u3063\u3066\u3044\u308B\u306D\uFF01"
  - "\u3055\u3044\u304D\u3093\u306E\u5927\u304D\u306A\u3058\u3057\u3093\u306B\n\u306E\u3068\u306F\u3093\u3068\u3046\u3058\u3057\u3093\u304C\u3042\u308B\u3088\u3002"
  - "\u3059\u3070\u3089\u3057\u3044\u306D\uFF01\n\u3067\u304D\u308C\u30703\u65E5\u5206\u3042\u308B\u3068\u5B89\u5FC3\u3060\u3088\u3002"
  - "\u3059\u3070\u3089\u3057\u3044\u306D\uFF01\n\u307B\u304B\u306B\u3057\u3093\u3071\u3044\u306A\u5834\u6240\u304C\u306A\u3044\u304B\u3001\n\u304B\u304F\u306B\u3093\u3057\u3088\u3046\u3002"
  - "\u3059\u3070\u3089\u3057\u3044\u306D\uFF01\n\u8A71\u3057\u5408\u3063\u3066\u304A\u304F\u3068\u5B89\u5FC3\u3060\u3088\u3002"
  - "\u4ECA\u304D\u3065\u3051\u305F\u3053\u3068\u304C\u3048\u3089\u3044\u3088\uFF01\n\u5C11\u3057\u305A\u3064\u3058\u3085\u3093\u3073\u3057\u3066\u3044\u3053\u3046\u3002"
  - "\u5B66\u6821\u306F\u5E83\u304F\u3066\u5B89\u5168\u3060\u306D\u3002\n\u591A\u304F\u306E\u3061\u3044\u304D\u3067\u306F\u3001\n\u5B66\u6821\u304C\u3072\u306A\u3093\u3058\u3087\u306B\u306A\u3063\u3066\u3044\u308B\u3088\u3002\n\u3069\u3053\u306E\u5B66\u6821\u304C\u3072\u306A\u3093\u3058\u3087\u306A\u306E\u304B\u3001\n\u304B\u304F\u306B\u3093\u3057\u3088\u3046\u3002"
  - "\u516C\u5712\u306F\u305F\u3066\u3082\u306E\u304C\u5C11\u306A\u304F\u3066\u3001\n\u3058\u3057\u3093\u306E\u3068\u304D\u306B\u4E00\u6642\u7684\u306B\n\u5B89\u5168\u306A\u5834\u6240\u306A\u3093\u3060\u3002"
  - "\u516C\u6C11\u9928\u306F\u591A\u304F\u306E\u3061\u3044\u304D\u3067\u3001\n\u3072\u306A\u3093\u3058\u3087\u3068\u3057\u3066\u4F7F\u308F\u308C\u3066\u3044\u308B\u3088\u3002\n\u8FD1\u304F\u306E\u516C\u6C11\u9928\u3092\u3055\u304C\u3057\u3066\u307F\u3088\u3046\u3002"
